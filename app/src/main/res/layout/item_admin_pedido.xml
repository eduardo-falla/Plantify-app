<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@color/white"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">

    <!-- ID y Estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvAdminOrderId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvAdminOrderEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="6dp"/>

    <!-- Comprador -->
    <TextView
        android:id="@+id/tvAdminCompradorNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:id="@+id/tvAdminCompradorEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/gray_medium"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <!-- Fecha -->
    <TextView
        android:id="@+id/tvAdminOrderFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gray_medium"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <!-- Productos -->
    <TextView
        android:id="@+id/tvAdminOrderItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:maxLines="4"
        android:ellipsize="end"
        android:layout_marginBottom="4dp"/>

    <!-- Dirección -->
    <TextView
        android:id="@+id/tvAdminOrderDireccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/gray_medium"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <!-- Total y botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAdminOrderTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/green_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnVerComprobante"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_normal"
            android:paddingHorizontal="10dp"
            android:gravity="center"
            android:text="🧾 Comprobante"
            android:textColor="@color/green_primary"
            android:textSize="11sp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnCambiarEstado"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_selected"
            android:paddingHorizontal="10dp"
            android:gravity="center"
            android:text="Cambiar estado"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Separador final -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"/>

</LinearLayout>